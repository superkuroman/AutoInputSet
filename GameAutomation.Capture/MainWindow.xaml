<Window x:Class="GameAutomation.Capture.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Automation Capture" Height="720" Width="1100" MinHeight="480" MinWidth="760">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <Button x:Name="SavePngButton" DockPanel.Dock="Right" Width="110" Margin="8,0,0,0"
                    Content="儲存 PNG" Click="SavePngButton_Click" IsEnabled="False" />
            <Button DockPanel.Dock="Right" Width="110" Margin="8,0,0,0" Content="擷取畫面" Click="CaptureButton_Click" />
            <Button DockPanel.Dock="Right" Width="110" Margin="8,0,0,0" Content="重新整理" Click="RefreshButton_Click" />
            <Button x:Name="PickWindowButton" DockPanel.Dock="Right" Width="125" Margin="8,0,0,0"
                    Content="滑鼠選取視窗" Click="PickWindowButton_Click" />
            <CheckBox x:Name="AutoRefreshCheckBox" DockPanel.Dock="Right" Margin="12,0,4,0"
                      VerticalAlignment="Center" Content="自動更新" IsChecked="True" />
            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="遊戲視窗" />
            <ComboBox x:Name="WindowSelector" MinWidth="420" DisplayMemberPath="DisplayName" />
        </DockPanel>
        <Border Grid.Row="1" Background="#181818" BorderBrush="#555" BorderThickness="1">
            <Image x:Name="ScreenshotImage" Stretch="Uniform" MouseMove="ScreenshotImage_MouseMove" />
        </Border>
        <StatusBar Grid.Row="2" Margin="0,12,0,0">
            <StatusBarItem><TextBlock x:Name="StatusText" Text="請選擇視窗並擷取畫面。" /></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock x:Name="CoordinateText" Text="Pixel: —    Normalized: —" /></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock Text="F8：快速存圖至 Templates" /></StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
